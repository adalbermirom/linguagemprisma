}                                                

local funcao url_decode(url) //(string)
    S(url)
    local err;
    local ret = url:troque('%%(%w%w)', funcao(w)
        local ha, hb = cod(w, 1, 2); //cod('FF', 1, 2) = cod('F'), cod('F')
        ha, hb = to_hex_tab[ha], to_hex_tab[hb];
        se ha == -1 ou hb == -1 entao
            err =  string.formate("hex code invalido: %%%s na posição: %d", w, (url:procure('%%'..w)));
            retorne nulo
        fim
        local c = ha * 16 + hb;
        retorne car(c);
    fim)
    se err entao
        retorne nulo, err;
    fim
    retorne ret;
fim

//imprima( url_decode('ol%c3%A1-tudo-bem-com-voc%C3%AA-caf%C3%A9') );//olá-tudo-bem-com-você-café

//https://admin:senha123@api.site.com:8080/v1/usuarios?status=ativo&ordem=desc#resultados
local funcao url_parse(url)
    S(url)
    // 1. Separa os 3 blocos principais
    local protocolo, autoridade, resto = url:separe('^([%w]+)://([^/]+)(.*)')
    
    // 2. Extrai dados da autoridade
    local user, pass, host = autoridade:separe('^([%w]+):(.-)@(.*)')
    local porta = autoridade:separe(':([%d]+)$')
    
    se nao host entao
        host = autoridade
    fim
    
    se host e porta entao
        host = host:separe('(.*):')
    fim
    
    // 3. Resolve Caminho, Query e Fragmento
    local path, query, fragmento
    se resto e resto <> "" entao
        // PASSO A: Isola o fragmento PRIMEIRO (pois ele é sempre a última coisa da URL)
        local antes_do_hash, frag = resto:separe('^(.-)#(.*)$')
        se frag entao
            fragmento = frag
            resto = antes_do_hash // O que sobra é apenas (path + query) ou só (path)
        fim

        // PASSO B: Isola a query (usando %? para escapar a interrogação literal)
        local p, q = resto:separe('^(.-)%?(.*)$') 
        se q entao
            path = p
            query = q
        senao
            path = resto // Se não tem query, tudo que sobrou é o caminho
        fim
    senao
        path = "/" // Se não tem resto nenhum, o path padrão da web é a barra raiz
    fim
  
    retorne {
        protocolo = protocolo,
        usuario = user,
        senha = pass,          // Corrigido: estava apontando para 'senha' (nulo)
        host = host,
        porta = porta,
        caminho = path,
        query = query,
        fragmento = fragmento
    }
fim

local imp = funcao(t)
    imprima('------------------');
    se tipo(t) == 'tabela' entao
        para k,v em pares(t) inicio
            imprima(k,v);
        fim
        retorne
    fim
    imprima(t)
fim

