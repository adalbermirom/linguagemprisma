local Args = inclua'args'


local _a_;

funcao printf(fmt, ...)
    se nao fmt entao
        _a_:use()
        sis.saia(1)
    fim
    local t = {...};
    local fmt = fmt:troque('\\n', '\n');
    para i, v em ipares(t) inicio
        t[i] = t[i]:troque('\\n', '\n');
    fim
    imprimaf(fmt, tabela.desempacote(t));
fim


funcao principal(arg)
    local a = Args:novo();
    _a_ = a;
    a:def_padrao(printf)
    :def('printf', printf, 'Imprime uma saída formatada, ex: printf.prisma "Ola %s\\n" mundo')
    :processe_args(arg);
    retorne 0;
fim