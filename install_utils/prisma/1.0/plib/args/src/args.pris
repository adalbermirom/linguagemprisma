\h4 O que essa lib faz?

<p>
Esta lib baseia-se em observar cada argumento presente na tabela global de argumentos Prisma: args.
</p>
<p>
Ao encontrar um comando registrado, a função é executada recebendo os argumentos de acordo com o num_args passado como 4º parâmetro no método Args:def(cmd, fn, info, num_args);
</p>

<p>
Os argumentos encontrados que não são registrados ou não são coletados por um comando registrado,
são passados para a função fallback de exceção, definida com o método Args:def_excecao(fn). Assim possibilitando coletar separadamente esses argumentos.
</p>



\h2 Exemplo:

\codigo
local Args = inclua'args'; //com = comando (linha de comando args...)
local a = Args:novo(); //cria um novo objeto da classe Com;

//define uma opção de linha de comando '-o'
a:def('-o', 
    funcao(fileout) 
        //se nao fileout entao a:use(); sis.saia(1); fim
        imprima('------> fileout:', fileout);
    fim, 
    'obtém o arquivo de saída: -o fileout',
    1
 );

//define a opção '-i'
a:def('-i', 
    funcao(filein)
        imprima('-----> filein:', filein);
    fim, 
    'obtém o arquivo de entrada.',
    1    
)

a:def_excecao(funcao(arg)
    imprima("Argumento não esperado:", arg);
    a:use();
    sis.saia(1);
fim)

//processa todos os argumentos de comandos definidos até agora.
a:processe_args({"-o", 'app.out', '-i', 'source.txt'});


//define mais um o '-h' (help)
a:def('-h', 
    funcao()
        poe'-------------------------------------';
        imprima('', "Ajuda")
        a:use(); //mostra todas as opções com informação se houver
    fim, 
    "Mostra a mensagem de ajuda.",
    0 //esse comando tem 0 argumentos.    
)

a:processe_args({'-h'}); //processando novamente só com a opção -h

//em a:processe_args(tab); troque tab pela tabela de argumentos 'args' Prisma.
\codigo--

*/
local Args = Classe{
    cmds = {};
    padrao = funcao()fim;
    fallback = funcao()fim;
    
    //todo argumento que não pertencer a um comando será pego pela função de exceção.
    def_excecao = funcao(este, fn)
        F(fn);
        este.fallback = fn;
        retorne este;
    fim;
    
    def_padrao = funcao(este, fn)
        F(fn);
        este.padrao = fn;
        retorne este;
    fim;
   

    def = funcao(este, cmd, fn, info, num_args) // <- Adicionado num_args
        T(este); S(cmd); F(fn);
        
        // Define o número de argumentos. Se não for numérico, assume -1 (variável)
        local aridade = (tipo(num_args) == 'numero' e num_args >= 0) e num_args ou -1;

        este.cmds[cmd] = {
            fn = fn, 
            info = info,
            num_args = aridade // Armazena a aridade (número de argumentos esperados)
        };
        retorne este;
    fim;
    
    processe_args = funcao(este, tab)
        T(este, tab);
        local tam_tab = #tab
        local n = falso;
        local i = 1;

        enquanto i <= tam_tab inicio
            local v = tab[i];
            
            se este.cmds[v] entao
                local cmd_def = este.cmds[v];
                local fn = cmd_def.fn
                local aridade = cmd_def.num_args; // Obtém a aridade definida
                
                local args_cmd = {};
                local prox_i = i + 1;
                local args_coletados = 0;

                // --- NOVA LÓGICA DE COLETA DE ARGUMENTOS ---
                
                // 1. Caso de aridade fixa (num_args >= 0)
                se aridade >= 0 entao
                    // Coleta o número exato de argumentos.
                    enquanto prox_i <= tam_tab e args_coletados < aridade inicio
                        tabela.insira(args_cmd, tab[prox_i]);
                        prox_i = prox_i + 1;
                        args_coletados = args_coletados + 1;
                    fim
                    
                // 2. Caso de aridade variável (num_args < 0 ou nulo)
                senao
                    // Coleta argumentos até o final ou até o próximo comando conhecido
                    enquanto prox_i <= tam_tab e nao este.cmds[tab[prox_i]] inicio
                        tabela.insira(args_cmd, tab[prox_i]);
                        prox_i = prox_i + 1;
                    fim
                fim
                // --- FIM DA LÓGICA DE COLETA ---

                // Executa a função do comando
                fn(tabela.desempacote(args_cmd) ); 
                
                // Atualiza o índice do loop principal para pular os argumentos processados
                i = prox_i;
                n = verdadeiro;
            
            senao
                este.fallback(v); // Trata argumento órfão/desconhecido
                i = i + 1;
            fim
        fim
        
        // Se nenhum comando foi encontrado, executa o padrão
        se nao n entao
            local fn = este.padrao;
            fn(tabela.desempacote(tab));
        fim
        retorne este;
    fim;
    
    //funcao use() lista os comandos registrados.
    use = funcao(este)
        local path, nome, ext = sis.nome_arquivo(args[0]);
        local prog = este.prog ou nome ou 'app';
        imprima('', 'Use: '..prog.. ' [opcao] args...');
        imprima('', "Em que '[opcao]' pode ser:");
        para k, v em pares(este.cmds) inicio
            imprima('', k ..' :', v.info ou '', 'Número args:', v.num_args);
        fim
        retorne este;
    fim
}


retorne Args


/*documentação dos métodos e exemplos:*/

--[[[
\fn Args:novo
\resumo Função contrutora da classe Args.
\param Sem parâmetros.
\retorno obj{tabela} - o objeto instanciado da classe Args.
]]
/*
    funcao Args:novo()
*/

/**
   \fn Args:def
   \resumo Define uma função callback para um argumento de linha de comando especificado em 'cmd';
    \param cmd {string} - o comando a ser registrado, exemplo: -o, --i,  --compile, --add, ajuda, --h etc.
    \param fn {funcao(...) fim} - função a ser executada quando o comando registrado for acionado.
    \param info {string} - (opcional) - string com a descrição do argumento de linha de comando.
    \param num_args {numero} - define o número de argumentos que um comando terá, se nulo ou menor que 0 o padrão é ler todos os argumentos até chegar a um novo comando.

    \retorno este {tabela} - o próprio objeto 'args' para ser usado em modo cascata, exemplo: obj:def('cmd1', fn, info):def(cmd2, fn2, info2):processe_args(args);
*/
/*
funcao Args:def(cmd, fn, info, num_args)
*/

/**
   \fn Args:def_padrao
   \resumo Define uma função callback padrão, a ser executada quando não houver nenhum comando encontrado.
    \param fn {funcao(...)fim} - função a ser executada quando o comando registrado for acionado.
    \retorno este {tabela} - o próprio objeto 'args' para ser usado em modo cascata, exemplo: obj:def('cmd1', fn, info):def(cmd2, fn2, info2):processe_args(args);
*/
/*
   funcao Args:def_padrao(fn)
*/


/**
   \fn Args:def_excecao
   \resumo Define uma função de tratamento de argumentos órfãos/desconhecidos, executada para cada item na linha de comando que não é um comando registrado e não pertence a um comando anterior.
    \param fn {funcao(arg)fim} - função a ser executada, recebendo o argumento desconhecido como parâmetro ('arg').
    \retorno este {tabela} - o próprio objeto 'args' para ser usado em modo cascata.
*/
/*
   funcao Args:def_excecao(fn)
*/


/**
   \fn Args:processe_args
   \resumo Processa todos os argumentos definidos, executando suas funções de callback.
   \param args {tabela} - a tabela args com os argumentos de linha de comando, ou outra tabela de sua escolha com os comandos.
   \retorno este {tabela} - o próprio objeto Args.
*/
/*
    funcao Args:processe_args(args)
*/

/**
    \fn Args:use
    \resumo Imprime na tela a descrição dos comandos definidos por meio da função Args:def();
    \param Nenhum
    \retorno este{tabela} - o próprio objeto Args.
*/
/* 
    funcao Args:use()
*/


/**
\seção Exemplo completo 1

\h4 pcopie orig file.txt dest copia.txt

\codigo pcopie.prisma
#!/usr/local/bin/prisma

local Args = inclua'args'
local a = Args:novo();

local orig, dest;

a:def('orig',  //nome comando
  funcao(arquivo_orig)  //funcao
    orig = arquivo_orig;
  fim, 
  'O arquivo a ser copiado, original.', //descrição do comando
  1 //o número de args para esse comando.
)

a:def('dest',  //nome do comando.
  funcao(arquivo_dest) //a função callback
    dest = arquivo_dest;
  fim, 
  'O arquivo de destino da cópia', //descrição deste comando
  1  // Um arg para este comando.
)

a:def('ajuda', 
  funcao()
    imprima'Aplicativo para copiar um arquivo';
    a:use();
  fim, 
  'Mostra a ajuda.'
  0  //nenhum arg para esse comando.
)

a:def_excecao(funcao(arg)
    imprima("Argumento não esperado!:", arg);
    a:use();
    sis.saia(1);
fim)

imprima(tabela.concat(args, ' '));

a:processe_args(args);

se nao orig ou nao dest entao
    a:use();
    sis.saia(1)
fim

local ok, err = sis.copie_arquivo(orig, dest);
se nao ok entao erro(err); fim
\codigo--
*/

/**
\seção Exemplo completo 2

\h4 mycc.prisma --saida fileout fonte1 fonte2 ...

\codigo mycc.prisma

//apenas um compilador teórico para exemplificar o uso da lib args.pris

local Args = inclua'args'; //o nome Args é para não ter conflitos com o global args.


funcao principal(arg)
    local a = Args:novo();
    local fontes = {};
    local arq_saida;
   // a ideia é pegar --saida saida_arq  e os demais argumentos soltos como fontes para compilação
   // não terá nenhum comando de compilação, apenas serão impresso os dados na tela!

    a:def_excecao(funcao(v)
        fontes[#fontes+1] = v; //vai pegar todos os args que não são argumentos de comandos, nem comandos.
    fim);
    
    a:def('--saida', //comando registrado
        funcao(fileOut) //funcao callback
            arq_saida = fileOut;
        fim, 
        'Arquivo de saída',  //descrição do comando
        1 //número de args para '--saida'
    );
    //tabela args ou tabela arg fictícia simulando: 'mycc.prisma fonte0 --saida app.out fonte1 fonte2 fonte3'
    //local arg = args[3] e args ou {"fonte0", "--saida", 'app.out', 'fonte1', 'fonte2', 'fonte3'}
    
    a:processe_args(arg); //args é o global, arg é o local passado para função principal(arg)
    
    se nao arq_saida entao
        imprima'Necessário definir um arquivo de saída.'
        a:use();
        imprima('Exemplo: mycc.prisma --saida app.out fonte1 fonte2 ...')
        sis.saia(1);
    fim

    se #fontes == 0 entao
        imprima("Necessário definir no mínimo um arquivo fonte para compilação.")
        imprima("mycc -o saida fonte1 fonte2...");
        sis.saia(1);
    fim
    
    imprima('Fontes:', tabela.concat(fontes, ', '));
    imprima('Saída:', arq_saida);
    
    retorne 0;  
fim

\codigo--
*/

